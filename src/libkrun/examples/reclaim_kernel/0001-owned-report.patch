+#else
+static int silo_reclaim_fail(struct silo_reclaim_diag *diag, int error)
+{
+	diag->state = SILO_RECLAIM_FAILED;
+	diag->error = -error;
+	return error;
+}
+
+/* Only metadata outside the disposable payload may be inspected in flight. */
+static int silo_reclaim_check_page(struct silo_reclaim_diag *diag)
+{
+	if (!diag->page || page_count(diag->page) != 1 ||
+	    PageCompound(diag->page) || PageReserved(diag->page) ||
+	    ((u64)page_to_pfn(diag->page) << PAGE_SHIFT) != diag->gpa)
+		return silo_reclaim_fail(diag, -EIO);
+	return 0;
+}
+
+/* The only reporting_vq consumer in this build; balloon_ack only wakes. */
+static int silo_reclaim_try_complete_locked(struct virtio_balloon *vb)
+{
+	struct silo_reclaim_diag *diag = &vb->diag;
+	unsigned int unused;
+	void *cookie;
+	int err;
+
+	if (diag->state == SILO_RECLAIM_FAILED)
+		return -diag->error;
+	if (diag->state != SILO_RECLAIM_INFLIGHT)
+		return 0;
+	if (!diag->submitted || diag->used_seen)
+		return silo_reclaim_fail(diag, -EIO);
+	err = silo_reclaim_check_page(diag);
+	if (err)
+		return err;
+	if (virtqueue_is_broken(vb->reporting_vq))
+		return silo_reclaim_fail(diag, -EIO);
+	cookie = virtqueue_get_buf(vb->reporting_vq, &unused);
+	if (virtqueue_is_broken(vb->reporting_vq))
+		return silo_reclaim_fail(diag, -EIO);
+	if (!cookie)
+		return 0;
+	if (cookie != diag)
+		return silo_reclaim_fail(diag, -EIO);
+	diag->used_seen = true;
+	diag->state = SILO_RECLAIM_ACKED;
+	return 0;
+}
+
+struct silo_reclaim_command {
+	enum silo_reclaim_operation operation;
+	char token[33];
+	u64 gpa;
+};
+
+static int silo_reclaim_parse(const char *buf, size_t count,
+			      struct silo_reclaim_command *command)
+{
+	size_t pos, i;
+	u64 gpa = 0;
+
+	/* Longest line: "donate " + token + " " + 20 GPA digits + LF. */
+	if (!count || count > 61 || buf[count - 1] != '\n')
+		return -EINVAL;
+	if (count >= 8 && !memcmp(buf, "prepare ", 8)) {
+		command->operation = SILO_RECLAIM_PREPARE;
+		pos = 8;
+	} else if (count >= 7 && !memcmp(buf, "donate ", 7)) {
+		command->operation = SILO_RECLAIM_DONATE;
+		pos = 7;
+	} else if (count >= 6 && !memcmp(buf, "reuse ", 6)) {
+		command->operation = SILO_RECLAIM_REUSE;
+		pos = 6;
+	} else if (count >= 7 && !memcmp(buf, "verify ", 7)) {
+		command->operation = SILO_RECLAIM_VERIFY;
+		pos = 7;
+	} else {
+		return -EINVAL;
+	}
+	if (count < pos + 33)
+		return -EINVAL;
+	for (i = 0; i < 32; i++) {
+		char c = buf[pos + i];
+
+		if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')))
+			return -EINVAL;
+		command->token[i] = c;
+	}
+	command->token[32] = '\0';
+	pos += 32;
+	if (command->operation == SILO_RECLAIM_PREPARE)
+		return pos + 1 == count ? 0 : -EINVAL;
+	if (buf[pos++] != ' ' || pos >= count - 1 ||
+	    count - 1 - pos > 20)
+		return -EINVAL;
+	for (; pos < count - 1; pos++) {
+		unsigned int digit;
+
+		if (buf[pos] < '0' || buf[pos] > '9')
+			return -EINVAL;
+		digit = buf[pos] - '0';
+		if (gpa > (U64_MAX - digit) / 10)
+			return -ERANGE;
+		gpa = gpa * 10 + digit;
+	}
+	if (gpa & (PAGE_SIZE - 1))
+		return -EINVAL;
+	command->gpa = gpa;
+	return 0;
+}
+
+static void silo_reclaim_record(struct silo_reclaim_diag *diag,
+				const struct silo_reclaim_command *command)
+{
+	diag->operation = command->operation;
+	memcpy(diag->token, command->token, sizeof(diag->token));
+}
+
+static u8 silo_reclaim_c_byte(unsigned int i)
+{
+	return 1 + ((i * 29 + 67) % 255);
+}
+
+static int silo_reclaim_read_c(struct silo_reclaim_diag *diag)
+{
+	const u8 *payload = page_address(diag->page);
+	u64 checksum = 14695981039346656037ULL;
+	u64 mismatches = 0;
+	unsigned int i;
+
+	/* Actual independent loads, including on a fresh restored guest. */
+	for (i = 0; i < PAGE_SIZE; i++) {
+		u8 byte = READ_ONCE(payload[i]);
+
+		if (byte != silo_reclaim_c_byte(i))
+			mismatches++;
+		checksum = (checksum ^ byte) * 1099511628211ULL;
+	}
+	diag->verified_bytes = PAGE_SIZE;
+	diag->mismatches = mismatches;
+	diag->checksum = checksum;
+	if (mismatches)
+		return silo_reclaim_fail(diag, -EIO);
+	return 0;
+}
+
+static int silo_reclaim_execute_locked(struct virtio_balloon *vb,
+				       const struct silo_reclaim_command *command)
+{
+	struct silo_reclaim_diag *diag = &vb->diag;
+	unsigned int i;
+	u8 *payload;
+	int err;
+
+	if (diag->stopping)
+		return -EBUSY;
+	if (diag->state == SILO_RECLAIM_FAILED)
+		return -diag->error;
+	if (command->operation == SILO_RECLAIM_PREPARE) {
+		if (diag->state != SILO_RECLAIM_EMPTY || diag->page)
+			return -EBUSY;
+		/* No direct reclaim or allocator wait in the sysfs command. */
+		diag->page = alloc_page(GFP_NOWAIT | __GFP_NOWARN);
+		if (!diag->page)
+			return -ENOMEM;
+		diag->gpa = (u64)page_to_pfn(diag->page) << PAGE_SHIFT;
+		err = silo_reclaim_check_page(diag);
+		if (err)
+			return err;
+		sg_init_table(&diag->sg, 1);
+		sg_set_page(&diag->sg, diag->page, PAGE_SIZE, 0);
+		diag->state = SILO_RECLAIM_OWNED;
+		silo_reclaim_record(diag, command);
+		return 0;
+	}
+	if (!diag->page || command->gpa != diag->gpa)
+		return -EINVAL;
+	err = silo_reclaim_check_page(diag);
+	if (err)
+		return err;
+	switch (command->operation) {
+	case SILO_RECLAIM_DONATE:
+		if (diag->state != SILO_RECLAIM_OWNED || diag->submitted ||
+		    diag->used_seen)
+			return -EBUSY;
+		if (virtqueue_is_broken(vb->reporting_vq))
+			return silo_reclaim_fail(diag, -EIO);
+		err = virtqueue_add_inbuf(vb->reporting_vq, &diag->sg, 1,
+					 diag, GFP_NOWAIT);
+		if (err)
+			return silo_reclaim_fail(diag, err);
+		diag->submitted = true;
+		diag->state = SILO_RECLAIM_INFLIGHT;
+		silo_reclaim_record(diag, command);
+		virtqueue_kick(vb->reporting_vq);
+		if (virtqueue_is_broken(vb->reporting_vq))
+			return silo_reclaim_fail(diag, -EIO);
+		return 0;
+	case SILO_RECLAIM_REUSE:
+		if (diag->state != SILO_RECLAIM_INFLIGHT &&
+		    diag->state != SILO_RECLAIM_ACKED)
+			return -EBUSY;
+		err = silo_reclaim_try_complete_locked(vb);
+		if (err)
+			return err;
+		if (diag->state == SILO_RECLAIM_INFLIGHT)
+			return -EAGAIN;
+		if (!diag->submitted || !diag->used_seen)
+			return silo_reclaim_fail(diag, -EIO);
+		err = silo_reclaim_check_page(diag);
+		if (err)
+			return err;
+		silo_reclaim_record(diag, command);
+		payload = page_address(diag->page);
+		/* The first post-ack payload operation overwrites every byte. */
+		for (i = 0; i < PAGE_SIZE; i++)
+			WRITE_ONCE(payload[i], silo_reclaim_c_byte(i));
+		err = silo_reclaim_read_c(diag);
+		if (!err)
+			diag->state = SILO_RECLAIM_C_READY;
+		return err;
+	case SILO_RECLAIM_VERIFY:
+		if (diag->state != SILO_RECLAIM_C_READY)
+			return -EBUSY;
+		if (!diag->submitted || !diag->used_seen)
+			return silo_reclaim_fail(diag, -EIO);
+		silo_reclaim_record(diag, command);
+		return silo_reclaim_read_c(diag);
+	default:
+		return -EINVAL;
+	}
+}
+
+static ssize_t silo_reclaim_show(struct device *dev,
+				struct device_attribute *attr, char *buf)
+{
+	static const char * const states[] = {
+		"empty", "owned", "inflight", "acked", "c-ready", "failed",
+	};
+	static const char * const operations[] = {
+		"none", "prepare", "donate", "reuse", "verify",
+	};
+	struct virtio_balloon *vb = dev_to_virtio(dev)->priv;
+	struct silo_reclaim_diag *diag = &vb->diag;
+	ssize_t count;
+
+	if (!mutex_trylock(&diag->lock))
+		return -EBUSY;
+	if (diag->stopping) {
+		mutex_unlock(&diag->lock);
+		return -EBUSY;
+	}
+	/* Status can harvest a used entry, but must never inspect payload. */
+	silo_reclaim_try_complete_locked(vb);
+	count = sysfs_emit(buf,
+		"abi=1 state=%s operation=%s token=%s gpa=%llu bytes=4096 "
+		"submitted=%u used_seen=%u verified_bytes=%u mismatches=%llu "
+		"checksum=%016llx error=%d\n",
+		states[diag->state], operations[diag->operation], diag->token,
+		(unsigned long long)diag->gpa, diag->submitted, diag->used_seen,
+		diag->verified_bytes, (unsigned long long)diag->mismatches,
+		(unsigned long long)diag->checksum, diag->error);
+	mutex_unlock(&diag->lock);
+	return count;
+}
+
+static ssize_t silo_reclaim_store(struct device *dev,
+				 struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct virtio_balloon *vb = dev_to_virtio(dev)->priv;
+	struct silo_reclaim_command command = {};
+	int err;
+
+	err = silo_reclaim_parse(buf, count, &command);
+	if (err)
+		return err;
+	if (!mutex_trylock(&vb->diag.lock))
+		return -EBUSY;
+	err = silo_reclaim_execute_locked(vb, &command);
+	mutex_unlock(&vb->diag.lock);
+	if (err)
+		return err;
+	return count;
+}
+
+static DEVICE_ATTR(silo_reclaim, 0600, silo_reclaim_show, silo_reclaim_store);
